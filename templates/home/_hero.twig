{# Receives block: texts (title, text, button_label, button_url). The first thing a visitor sees:
   the lots, with a search for them where the catalogue is installed. #}
{% set searchable = has_catalogue() %}
<section class="hero hero-auction">
    <div class="container">
        <p class="badge"><span class="live-dot" aria-hidden="true"></span>{{ trans('theme.hero.badge') }}</p>
        <h1 data-field="title">{{ block.texts.title }}</h1>
        {% if block.texts.text or edit_mode() %}<p class="lead" data-field="text">{{ block.texts.text }}</p>{% endif %}
        {% if searchable %}
            <form method="get" action="{{ url('/offers') }}" class="search-box" role="search">
                <label class="visually-hidden" for="hero-q">{{ trans('core.offers.search') }}</label>
                <div class="search-field">
                    <input id="hero-q" name="q" type="search" placeholder="{{ trans('theme.hero.search_placeholder') }}">
                </div>
                <button type="submit">{{ trans('theme.hero.search_submit') }}</button>
            </form>
        {% endif %}
        {% if block.texts.button_label and block.texts.button_url %}
            <p><a class="button large" href="{{ block.texts.button_url starts with '/' ? url(block.texts.button_url) : block.texts.button_url }}">{{ block.texts.button_label }}</a></p>
        {% endif %}
    </div>
</section>
